# Copy these names into .env.local and your hosting provider's environment.
# These are placeholders, not working credentials.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLIC_PUBLISHABLE_KEY
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# On Vercel production use: https://www.bandeshaempire.com

# Enable only after the database, Google provider and email setup are complete.
PORTAL_ENABLED=false

# Never add a service-role key, Google secret or password to NEXT_PUBLIC_*.
